{
  "name": "nimbus-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do Nimbus (LMS + fluxo S3 -> SQS -> Lambda -> DynamoDB) contra FakeCloud",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx --watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration",
    "lambda:build": "node lambda/build.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:all": "drizzle-kit generate && drizzle-kit migrate && tsx --env-file=.env src/db/seed.ts",
    "cleanup": "node scripts/cleanup.mjs"
  },
  "keywords": [
    "nimbus",
    "fakecloud",
    "express",
    "typescript"
  ],
  "author": "Drummonds",
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.1",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@aws-sdk/lib-storage": "^3.0.0",
    "@scalar/express-api-reference": "^0.8.40",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "file-type": "^21.1.1",
    "helmet": "^8.1.0",
    "jspdf": "^4.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.0.0"
  }
}
